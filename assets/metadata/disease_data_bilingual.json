{
  "newcastle_disease": {
    "display_name": {
      "en": "Newcastle Disease",
      "hi": "रानीखेत रोग"
    },
    "overview": {
      "en": "Newcastle disease is a highly contagious viral disease affecting poultry birds. It spreads rapidly and may cause severe mortality.",
      "hi": "न्यूकैसल रोग पोल्ट्री पक्षियों को प्रभावित करने वाला अत्यधिक संक्रामक वायरल रोग है। यह तेजी से फैलता है और गंभीर मृत्यु दर का कारण बन सकता है।"
    },
    "mortality": {
      "en": "Very High (>90%)",
      "hi": "बहुत अधिक (>90%)"
    },
    "symptoms": [
      {
        "en": "Twisted neck",
        "hi": "गर्दन का मुड़ना"
      },
      {
        "en": "Green-white diarrhea",
        "hi": "हरे-सफेद रंग का दस्त"
      },
      {
        "en": "Facial swelling",
        "hi": "चेहरे पर सूजन"
      },
      {
        "en": "Paralysis of legs or wings",
        "hi": "पैरों या पंखों का लकवा"
      },
      {
        "en": "Respiratory distress",
        "hi": "सांस लेने में कठिनाई"
      },
      {
        "en": "Drooping wings",
        "hi": "पंखों का लटकना"
      },
      {
        "en": "Open-mouth breathing",
        "hi": "मुंह खोलकर सांस लेना"
      },
      {
        "en": "Bluish comb",
        "hi": "कलगी का नीला पड़ना"
      },
      {
        "en": "Depression",
        "hi": "सुस्ती और उदासी"
      },
      {
        "en": "Foamy nasal discharge",
        "hi": "नाक से झागदार स्राव"
      },
      {
        "en": "Coughing",
        "hi": "खांसी"
      },
      {
        "en": "Sneezing",
        "hi": "छींकना"
      },
      {
        "en": "Reduced feed intake",
        "hi": "चारे का सेवन कम होना"
      },
      {
        "en": "Sudden drop in egg production",
        "hi": "अंडा उत्पादन में अचानक कमी"
      },
      {
        "en": "Thin-shelled eggs",
        "hi": "पतले छिलके वाले अंडे"
      }
    ],
    "treatment": {
      "en": "No specific treatment is available for Newcastle disease.",
      "hi": "न्यूकैसल रोग के लिए कोई विशिष्ट उपचार उपलब्ध नहीं है।"
    },
    "immediate_actions": [
      {
        "en": "Isolate infected birds",
        "hi": "संक्रमित पक्षियों को अलग करें"
      },
      {
        "en": "Disinfect the farm",
        "hi": "फार्म को कीटाणुरहित करें"
      },
      {
        "en": "Consult veterinarian immediately",
        "hi": "तुरंत पशु चिकित्सक से परामर्श करें"
      },
      {
        "en": "Restrict visitor access",
        "hi": "बाहरी लोगों का प्रवेश सीमित करें"
      },
      {
        "en": "Safely dispose dead birds",
        "hi": "मृत पक्षियों का सुरक्षित निपटान करें"
      }
    ],
    "differential_diagnosis": [
      {
        "en": "Infectious Bronchitis",
        "hi": "संक्रामक ब्रोंकाइटिस"
      },
      {
        "en": "Fowl Cholera",
        "hi": "फाउल कॉलरा"
      },
      {
        "en": "Mycoplasmosis",
        "hi": "माइकोप्लाज्मोसिस"
      },
      {
        "en": "Infectious Coryza",
        "hi": "संक्रामक कोराइजा"
      }
    ],
