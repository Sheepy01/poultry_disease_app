  "aflatoxicosis": {
    "display_name": {
      "en": "Aflatoxicosis",
      "hi": "अफ्लाटॉक्सिकोसिस"
    },
    "overview": {
      "en": "A toxin-related disease caused by aflatoxin-contaminated feed. It primarily damages the liver and can result in poor growth, weakness, and significant mortality in poultry.",
      "hi": "अफ्लाटॉक्सिन-दूषित चारे से होने वाला विष-संबंधी रोग। यह मुख्य रूप से यकृत को नुकसान पहुंचाता है और पोल्ट्री में खराब वृद्धि, कमजोरी तथा उल्लेखनीय मृत्यु दर का कारण बन सकता है।"
    },
    "mortality": {
      "en": "Moderate to High depending on toxin exposure",
      "hi": "विष के संपर्क की मात्रा के अनुसार मध्यम से अधिक"
    },
    "symptoms": [
      {
        "en": "Weakness",
        "hi": "कमजोरी"
      },
      {
        "en": "Poor growth",
        "hi": "विकास कम होना"
      },
      {
        "en": "Unthriftiness",
        "hi": "कमजोर और अस्वस्थ वृद्धि"
      },
      {
        "en": "High morbidity",
        "hi": "रोगग्रस्तता अधिक होना"
      },
      {
        "en": "High mortality",
        "hi": "मृत्यु दर अधिक होना"
      },
      {
        "en": "Depression",
        "hi": "सुस्ती और उदासी"
      },
      {
        "en": "Reduced feed efficiency",
        "hi": "चारे की उपयोग क्षमता कम होना"
      }
    ],
    "treatment": {
      "en": "No specific treatment is available. Remove contaminated feed and provide supportive care.",
      "hi": "कोई विशिष्ट उपचार उपलब्ध नहीं है। दूषित चारा हटाएं और सहायक देखभाल दें।"
    },
    "immediate_actions": [
      {
        "en": "Remove contaminated feed immediately",
        "hi": "दूषित चारा तुरंत हटाएं"
      },
      {
        "en": "Provide clean uncontaminated feed",
        "hi": "स्वच्छ और अदूषित चारा दें"
      },
      {
        "en": "Supplement Vitamin E",
        "hi": "विटामिन ई पूरक दें"
      },
      {
        "en": "Supplement Vitamin C",
        "hi": "विटामिन सी पूरक दें"
      },
      {
        "en": "Supplement Selenium",
        "hi": "सेलेनियम पूरक दें"
      },
      {
        "en": "Treat secondary infections",
        "hi": "द्वितीयक संक्रमणों का उपचार करें"
      },
      {
        "en": "Improve farm management",
        "hi": "फार्म प्रबंधन में सुधार करें"
      },
      {
        "en": "Provide activated charcoal if recommended",
        "hi": "सलाह मिलने पर एक्टिवेटेड चारकोल दें"
      }
    ],
    "differential_diagnosis": [
      {
        "en": "Fatty Liver Syndrome",
        "hi": "फैटी लिवर सिंड्रोम"
      },
      {
        "en": "Hepatitis",
        "hi": "हेपेटाइटिस"
      },
      {
        "en": "Feed Toxicity",
        "hi": "चारा विषाक्तता"
      },
      {
        "en": "Nutritional Deficiencies",
        "hi": "पोषण संबंधी कमियां"
      }
    ],
